# Auto detect text files and perform LF normalization
* text=auto

# Ensure shell scripts and Makefile always use LF line endings
*.sh text eol=lf
Makefile text eol=lf

# Ensure source files use LF
*.cpp text eol=lf
*.h text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
