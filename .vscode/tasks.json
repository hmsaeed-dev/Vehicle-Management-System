{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Project",
      "type": "shell",
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compile C++ project using Makefile"
    },
    {
      "label": "Run Application",
      "type": "shell",
      "command": "./VehicleManagSys",
      "dependsOn": "Build Project",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Run compiled Vehicle Management System in terminal"
    },
    {
      "label": "Clean Project",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": [],
      "detail": "Remove compiled binary and object files"
    }
  ]
}
